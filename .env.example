# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Enterprise Identity Service Configuration
NODE_ENV="development"
PORT=3000

# Security secrets (will default to secure fallbacks in development)
JWT_ACCESS_SECRET="enterprise_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="enterprise_super_secret_jwt_refresh_key_2026"

# Token Lifespans
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS configurations
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
